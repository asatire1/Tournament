{
  "rules": {
    "users": {
      ".read": true,
      ".indexOn": ["googleUid", "authUid", "email", "playtomicUsername"],
      "$userId": {
        ".write": "auth != null && auth.uid == $userId",
        ".validate": "newData.hasChildren(['name', 'type'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
        },
        "type": {
          ".validate": "newData.isString() && (newData.val() == 'guest' || newData.val() == 'registered')"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() == 'pending' || newData.val() == 'verified')"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "googleUid": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "authUid": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "authProvider": {
          ".validate": "newData.isString() && (newData.val() == 'google' || newData.val() == 'email' || newData.val() == 'anonymous')"
        },
        "playtomicUsername": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
        },
        "playtomicLevel": {
          ".validate": "(newData.isNumber() && newData.val() >= 0 && newData.val() <= 10) || newData.val() == null"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "isOrganizer": {
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isString()"
        },
        "updatedAt": {
          ".validate": "newData.isString()"
        },

        "currentPlaytomicVerification": {
          ".write": "auth != null && auth.uid == $userId",
          "verificationId":    { ".validate": "newData.isString() && newData.val().length <= 64" },
          "status":            { ".validate": "newData.isString() && (newData.val() == 'pending' || newData.val() == 'verified' || newData.val() == 'rejected' || newData.val() == 'expired')" },
          "extractedRating":   { ".validate": "(newData.isNumber() && newData.val() >= 0 && newData.val() <= 10) || newData.val() == null" },
          "extractedName":     { ".validate": "newData.isString() || newData.val() == null" },
          "verifiedAt":        { ".validate": "newData.isString() || newData.val() == null" },
          "expiresAt":         { ".validate": "newData.isString() || newData.val() == null" }
        },

        "notifications": {
          ".read":  "auth != null && auth.uid == $userId",
          ".write": "auth != null && auth.uid == $userId",
          "$notificationId": {
            ".validate": "newData.hasChildren(['type', 'title', 'body', 'read', 'createdAt'])",
            "type": {
              ".validate": "newData.isString() && (newData.val() == 'match_ready' || newData.val() == 'tournament_start' || newData.val() == 'result_posted' || newData.val() == 'tournament_complete' || newData.val() == 'registration_confirmed')"
            },
            "title":        { ".validate": "newData.isString() && newData.val().length <= 100" },
            "body":         { ".validate": "newData.isString() && newData.val().length <= 300" },
            "tournamentId": { ".validate": "newData.isString() || newData.val() == null" },
            "read":         { ".validate": "newData.isBoolean()" },
            "createdAt":    { ".validate": "newData.isString()" }
          }
        },

        "ratings": {
          ".read": true,
          ".write": "auth != null && auth.uid == $userId"
        }
      }
    },

    "userRatings": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || auth.token.admin == true)",
        "uid":          { ".validate": "newData.isString()" },
        "rating":       { ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 3000" },
        "confidence":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
        "gamesPlayed":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "lastPlayedAt": { ".validate": "newData.isString()" },
        "updatedAt":    { ".validate": "newData.isString()" },
        "history": {
          "$matchId": {
            ".validate": "newData.hasChildren(['before', 'after', 'delta', 'timestamp'])"
          }
        }
      }
    },

    "americano-tournaments": {
      ".read": true,
      ".indexOn": ["meta/organizerUid", "meta/updatedAt", "meta/createdAt"],
      "$tournamentId": {
        ".write": "auth != null && (!data.exists() || !data.child('meta/organizerUid').exists() || data.child('meta/organizerUid').val() == auth.uid || (newData.child('meta/organizerUid').val() == auth.uid && data.child('meta/organiserKey').exists() && newData.child('meta/organiserKey').val() == data.child('meta/organiserKey').val()))",
        ".validate": "$tournamentId.matches(/^[a-zA-Z0-9]{6,20}$/)",
        "scores": {
          "$matchId": {
            ".write": true,
            "team1": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
            },
            "team2": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
            }
          }
        },
        "meta": {
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          },
          "organiserKey": {
            ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 64"
          },
          "passcodeHash": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
          },
          "createdAt": {
            ".validate": "newData.isString()"
          },
          "updatedAt": {
            ".validate": "newData.isString()"
          },
          "organizerUid": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          }
        },
        "playerCount": {
          ".validate": "newData.isNumber() && newData.val() >= 4 && newData.val() <= 24"
        },
        "playerNames": {
          "$index": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
          }
        },
        "courtCount": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
        },
        "courtNames": {
          "$index": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
          }
        },
        "fixedPoints": {
          ".validate": "newData.isBoolean()"
        },
        "totalPoints": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
        }
      }
    },
    "mexicano-tournaments": {
      ".read": true,
      ".indexOn": ["meta/organizerUid", "meta/updatedAt", "meta/createdAt"],
      "$tournamentId": {
        ".write": "auth != null && (!data.exists() || !data.child('meta/organizerUid').exists() || data.child('meta/organizerUid').val() == auth.uid || (newData.child('meta/organizerUid').val() == auth.uid && data.child('meta/organiserKey').exists() && newData.child('meta/organiserKey').val() == data.child('meta/organiserKey').val()))",
        ".validate": "$tournamentId.matches(/^[a-zA-Z0-9]{6,20}$/)",
        "scores": {
          "$matchId": {
            ".write": true,
            "team1": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
            },
            "team2": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
            }
          }
        },
        "meta": {
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          },
          "organiserKey": {
            ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 64"
          },
          "passcodeHash": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
          },
          "organizerUid": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          }
        },
        "playerCount": {
          ".validate": "newData.isNumber() && newData.val() >= 4 && newData.val() <= 24"
        },
        "playerNames": {
          "$index": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
          }
        },
        "courtCount": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
        }
      }
    },
    "tournaments": {
      ".read": true,
      ".indexOn": ["meta/organizerUid", "meta/updatedAt", "meta/createdAt", "meta/isPublic", "meta/status", "meta/format", "meta/startDate", "meta/registrationMode"],
      "$tournamentId": {
        ".write": "auth != null && (!data.exists() || !data.child('meta/organizerUid').exists() || data.child('meta/organizerUid').val() == auth.uid || (newData.child('meta/organizerUid').val() == auth.uid && data.child('meta/organiserKey').exists() && newData.child('meta/organiserKey').val() == data.child('meta/organiserKey').val()))",
        ".validate": "$tournamentId.matches(/^[a-zA-Z0-9]{6,20}$/)",
        "scores": {
          "$matchId": {
            ".write": "auth != null",
            "team1": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99" },
            "team2": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99" }
          }
        },
        "meta": {
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          },
          "format": {
            ".validate": "newData.isString() && (newData.val() == 'americano' || newData.val() == 'mexicano' || newData.val() == 'mix' || newData.val() == 'team-league' || newData.val() == 'fixed-pair' || newData.val() == 'mixicano' || newData.val() == 'round-robin' || newData.val() == 'knockout' || newData.val() == 'swiss')"
          },
          "registrationMode": {
            ".validate": "newData.isString() && (newData.val() == 'open' || newData.val() == 'names_only')"
          },
          "status": {
            ".validate": "newData.isString() && (newData.val() == 'draft' || newData.val() == 'open_for_registration' || newData.val() == 'registration_closed' || newData.val() == 'active' || newData.val() == 'completed' || newData.val() == 'cancelled')"
          },
          "isPublic": { ".validate": "newData.isBoolean()" },
          "mode": { ".validate": "newData.isString() && (newData.val() == 'anyone' || newData.val() == 'locked')" },
          "organiserKey": {
            ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 64"
          },
          "passcodeHash": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
          },
          "organizerUid": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "createdAt": { ".validate": "newData.isString()" },
          "updatedAt": { ".validate": "newData.isString()" },
          "startDate": { ".validate": "newData.isString() || newData.val() == null" },
          "registrationDeadline": { ".validate": "newData.isString() || newData.val() == null" },
          "entryFeeGBP": { ".validate": "(newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000) || newData.val() == null" },
          "currency": { ".validate": "newData.isString() && newData.val() == 'GBP'" },
          "stripeAccountId": { ".validate": "newData.isString() || newData.val() == null" },
          "location": {
            "postcode": { ".validate": "newData.isString() && newData.val().length <= 10" },
            "line1":    { ".validate": "newData.isString() && newData.val().length <= 200" },
            "venue":    { ".validate": "newData.isString() && newData.val().length <= 100" },
            "lat":      { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
            "lng":      { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" }
          },
          "ratingLimit": {
            "type": { ".validate": "newData.isString() && (newData.val() == 'none' || newData.val() == 'individual' || newData.val() == 'combined')" },
            "min":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
            "max":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" }
          },
          "formatConfig": {
            "matchFormat": { ".validate": "newData.isString() && (newData.val() == 'round-robin' || newData.val() == 'groups+ko' || newData.val() == 'knockout')" },
            "courts":      { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20" },
            "pointsPerMatch": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100" }
          }
        },
        "playerCount": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 200"
        },
        "namesOnlyRoster": {
          "playerNames": {
            "$index": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50" }
          },
          "teamNames": {
            "$index": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50" }
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.hasChildren(['name'])",
            "name":          { ".validate": "newData.isString() && newData.val().length <= 50" },
            "rating":        { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
            "registeredAt":  { ".validate": "newData.isString()" },
            "paymentStatus": { ".validate": "newData.isString() && (newData.val() == 'free' || newData.val() == 'pending' || newData.val() == 'paid' || newData.val() == 'refunded')" },
            "stripeSessionId": { ".validate": "newData.isString()" }
          }
        },
        "pairs": {
          "$pairId": {
            ".write": "auth != null && (newData.child('player1Uid').val() == auth.uid || newData.child('player2Uid').val() == auth.uid || data.child('player1Uid').val() == auth.uid || data.child('player2Uid').val() == auth.uid)",
            "player1Uid":    { ".validate": "newData.isString()" },
            "player2Uid":    { ".validate": "newData.isString()" },
            "player1Name":   { ".validate": "newData.isString() && newData.val().length <= 50" },
            "player2Name":   { ".validate": "newData.isString() && newData.val().length <= 50" },
            "combinedRating":{ ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 40" },
            "registeredAt":  { ".validate": "newData.isString()" },
            "paymentStatus": { ".validate": "newData.isString() && (newData.val() == 'free' || newData.val() == 'pending' || newData.val() == 'paid' || newData.val() == 'refunded')" },
            "stripeSessionId": { ".validate": "newData.isString()" },
            "cancelledAt":   { ".validate": "newData.isString() || newData.val() == null" }
          }
        },
        "finalStandings": {
          ".write": false
        }
      }
    },

    "postcode_cache": {
      ".read": true,
      ".write": false,
      "$key": {
        "cachedAt": { ".validate": "newData.isNumber()" },
        "data": {
          "postcode": { ".validate": "newData.isString()" },
          "lat":      { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
          "lng":      { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" }
        }
      }
    },

    "stripe_accounts": {
      "$uid": {
        ".read":  "auth != null && auth.uid == $uid",
        ".write": false,
        "stripeAccountId":           { ".validate": "newData.isString() && newData.val().length <= 128" },
        "chargesEnabled":            { ".validate": "newData.isBoolean()" },
        "payoutsEnabled":            { ".validate": "newData.isBoolean()" },
        "detailsSubmitted":          { ".validate": "newData.isBoolean()" },
        "requirementsCurrentlyDue":  {},
        "requirementsDisabledReason":{ ".validate": "newData.isString() || newData.val() == null" },
        "country":                   { ".validate": "newData.isString() || newData.val() == null" },
        "defaultCurrency":           { ".validate": "newData.isString() || newData.val() == null" },
        "createdAt":                 { ".validate": "newData.isString()" },
        "updatedAt":                 { ".validate": "newData.isString()" },
        "lastWebhookAt":             { ".validate": "newData.isString() || newData.val() == null" }
      }
    },

    "stripe_events": {
      ".read":  false,
      ".write": false
    },

    "pair_invites": {
      ".read":  false,
      ".write": false,
      "$inviteId": {
        "tournamentId":  { ".validate": "newData.isString() && newData.val().length <= 32" },
        "invitedBy":     { ".validate": "newData.isString() && newData.val().length <= 128" },
        "invitedByName": { ".validate": "newData.isString() || newData.val() == null" },
        "partnerEmail":  { ".validate": "newData.isString() && newData.val().length <= 200" },
        "status":        { ".validate": "newData.isString() && (newData.val() == 'pending' || newData.val() == 'accepted' || newData.val() == 'expired' || newData.val() == 'cancelled')" },
        "createdAt":     { ".validate": "newData.isString()" },
        "expiresAt":     { ".validate": "newData.isString()" },
        "acceptedAt":    { ".validate": "newData.isString() || newData.val() == null" }
      }
    },

    "pair_claim_tokens": {
      ".read":  false,
      ".write": false,
      "$tokenHash": {
        "tournamentId":  { ".validate": "newData.isString() && newData.val().length <= 32" },
        "createdBy":     { ".validate": "newData.isString() && newData.val().length <= 128" },
        "createdByName": { ".validate": "newData.isString() || newData.val() == null" },
        "usesRemaining": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "expiresAt":     { ".validate": "newData.isString()" },
        "createdAt":     { ".validate": "newData.isString()" },
        "revoked":       { ".validate": "newData.isBoolean()" }
      }
    },

    "playtomic_verifications": {
      "$uid": {
        ".read":  "auth != null && (auth.uid == $uid || auth.token.admin == true)",
        ".indexOn": ["status", "expiresAt", "createdAt"],
        ".write": false,
        "$verificationId": {
          "uid":              { ".validate": "newData.isString() && newData.val() == $uid" },
          "storagePath":      { ".validate": "newData.isString() && newData.val().length <= 512" },
          "screenshotUrl":    { ".validate": "newData.isString() || newData.val() == null" },
          "extractedName":    { ".validate": "newData.isString() || newData.val() == null" },
          "extractedUsername":{ ".validate": "newData.isString() || newData.val() == null" },
          "extractedRating":  { ".validate": "(newData.isNumber() && newData.val() >= 0 && newData.val() <= 10) || newData.val() == null" },
          "screenshotDate":   { ".validate": "newData.isString() || newData.val() == null" },
          "aiConfidence":     { ".validate": "(newData.isNumber() && newData.val() >= 0 && newData.val() <= 1) || newData.val() == null" },
          "aiModel":          { ".validate": "newData.isString() && newData.val().length <= 128" },
          "aiRawResponse":    { ".validate": "newData.isString() || newData.val() == null" },
          "status":           { ".validate": "newData.isString() && (newData.val() == 'pending' || newData.val() == 'verified' || newData.val() == 'rejected' || newData.val() == 'expired')" },
          "failureReason":    { ".validate": "newData.isString() || newData.val() == null" },
          "createdAt":        { ".validate": "newData.isString()" },
          "verifiedAt":       { ".validate": "newData.isString() || newData.val() == null" },
          "expiresAt":        { ".validate": "newData.isString() || newData.val() == null" },
          "reviewedBy":       { ".validate": "newData.isString() || newData.val() == null" }
        }
      }
    },
    "team-tournaments": {
      ".read": true,
      ".indexOn": ["meta/organizerUid", "meta/updatedAt", "meta/createdAt"],
      "$tournamentId": {
        ".write": "auth != null && (!data.exists() || !data.child('meta/organizerUid').exists() || data.child('meta/organizerUid').val() == auth.uid || (newData.child('meta/organizerUid').val() == auth.uid && data.child('meta/organiserKey').exists() && newData.child('meta/organiserKey').val() == data.child('meta/organiserKey').val()))",
        ".validate": "$tournamentId.matches(/^[a-zA-Z0-9]{6,20}$/)",
        "scores": {
          "$matchId": {
            ".write": true
          }
        },
        "groupMatchScores": {
          ".write": "auth != null"
        },
        "knockoutScores": {
          ".write": "auth != null"
        },
        "knockoutTeams": {
          ".write": "auth != null"
        },
        "meta": {
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          }
        },
        "teamCount": {
          ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 36"
        }
      }
    },
    "mixicano-tournaments": {
      ".read": true,
      ".indexOn": ["meta/organizerUid", "meta/updatedAt", "meta/createdAt"],
      "$tournamentId": {
        ".write": "auth != null && (!data.exists() || !data.child('meta/organizerUid').exists() || data.child('meta/organizerUid').val() == auth.uid || (newData.child('meta/organizerUid').val() == auth.uid && data.child('meta/organiserKey').exists() && newData.child('meta/organiserKey').val() == data.child('meta/organiserKey').val()))",
        ".validate": "$tournamentId.matches(/^[a-zA-Z0-9]{6,20}$/)",
        "scores": {
          "$matchId": {
            ".write": true
          }
        },
        "meta": {
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          },
          "organiserKey": {
            ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 64"
          },
          "passcodeHash": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
          },
          "organizerUid": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          }
        },
        "playerCount": {
          ".validate": "newData.isNumber() && newData.val() >= 4 && newData.val() <= 80"
        }
      }
    },
    "roundrobin-tournaments": {
      ".read": true,
      ".indexOn": ["meta/organizerUid", "meta/updatedAt", "meta/createdAt"],
      "$tournamentId": {
        ".write": "auth != null && (!data.exists() || !data.child('meta/organizerUid').exists() || data.child('meta/organizerUid').val() == auth.uid || (newData.child('meta/organizerUid').val() == auth.uid && data.child('meta/organiserKey').exists() && newData.child('meta/organiserKey').val() == data.child('meta/organiserKey').val()))",
        ".validate": "$tournamentId.matches(/^[a-zA-Z0-9]{6,20}$/)",
        "scores": {
          "$matchId": {
            ".write": true
          }
        },
        "meta": {
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          },
          "organiserKey": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 64"
          },
          "organizerUid": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          }
        }
      }
    },
    "knockout-tournaments": {
      ".read": true,
      ".indexOn": ["meta/organizerUid", "meta/updatedAt", "meta/createdAt"],
      "$tournamentId": {
        ".write": "auth != null && (!data.exists() || !data.child('meta/organizerUid').exists() || data.child('meta/organizerUid').val() == auth.uid || (newData.child('meta/organizerUid').val() == auth.uid && data.child('meta/organiserKey').exists() && newData.child('meta/organiserKey').val() == data.child('meta/organiserKey').val()))",
        ".validate": "$tournamentId.matches(/^[a-zA-Z0-9]{6,20}$/)",
        "scores": {
          "$matchId": {
            ".write": true,
            "team1": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
            },
            "team2": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
            }
          }
        },
        "meta": {
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          },
          "organiserKey": {
            ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 64"
          },
          "passcodeHash": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
          },
          "createdAt":   { ".validate": "newData.isString()" },
          "updatedAt":   { ".validate": "newData.isString()" },
          "organizerUid":{ ".validate": "newData.isString() && newData.val().length <= 128" }
        }
      }
    },
    "swiss-tournaments": {
      ".read": true,
      ".indexOn": ["meta/organizerUid", "meta/updatedAt", "meta/createdAt"],
      "$tournamentId": {
        ".write": "auth != null && (!data.exists() || !data.child('meta/organizerUid').exists() || data.child('meta/organizerUid').val() == auth.uid || (newData.child('meta/organizerUid').val() == auth.uid && data.child('meta/organiserKey').exists() && newData.child('meta/organiserKey').val() == data.child('meta/organiserKey').val()))",
        ".validate": "$tournamentId.matches(/^[a-zA-Z0-9]{6,20}$/)",
        "scores": {
          "$matchId": {
            ".write": true
          }
        },
        "meta": {
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          },
          "organiserKey": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 64"
          },
          "organizerUid": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          }
        }
      }
    },
    "team-leagues": {
      ".read": true,
      ".indexOn": ["meta/organizerUid", "meta/updatedAt", "meta/createdAt"],
      "$tournamentId": {
        ".write": "auth != null && (!data.exists() || !data.child('meta/organizerUid').exists() || data.child('meta/organizerUid').val() == auth.uid || (newData.child('meta/organizerUid').val() == auth.uid && data.child('meta/organiserKey').exists() && newData.child('meta/organiserKey').val() == data.child('meta/organiserKey').val()))",
        ".validate": "$tournamentId.matches(/^[a-zA-Z0-9]{6,20}$/)",
        "scores": {
          "$matchId": {
            ".write": true
          }
        }
      }
    },
    "fixed-tournaments": {
      ".read": true,
      ".indexOn": ["meta/organizerUid", "meta/updatedAt", "meta/createdAt"],
      "$tournamentId": {
        ".write": "auth != null && (!data.exists() || !data.child('meta/organizerUid').exists() || data.child('meta/organizerUid').val() == auth.uid || (newData.child('meta/organizerUid').val() == auth.uid && data.child('meta/organiserKey').exists() && newData.child('meta/organiserKey').val() == data.child('meta/organiserKey').val()))",
        ".validate": "$tournamentId.matches(/^[a-zA-Z0-9]{6,20}$/)",
        "scores": {
          "$matchId": {
            ".write": true
          }
        }
      }
    },
    "competitions": {
      ".read": true,
      ".indexOn": ["meta/eventDate", "meta/status", "meta/format", "meta/organizerId", "meta/createdAt"],
      "$competitionId": {
        ".write": "auth != null && (!data.exists() || !data.child('meta/organizerId').exists() || data.child('meta/organizerId').val() == auth.uid)",
        "meta": {
          ".validate": "newData.hasChildren(['name', 'format', 'status'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          },
          "format": {
            ".validate": "newData.isString() && (newData.val() == 'americano' || newData.val() == 'mexicano' || newData.val() == 'mix' || newData.val() == 'team-league')"
          },
          "status": {
            ".validate": "newData.isString() && (newData.val() == 'draft' || newData.val() == 'registration' || newData.val() == 'active' || newData.val() == 'completed' || newData.val() == 'cancelled')"
          },
          "accessRestriction": {
            ".validate": "newData.isString() && (newData.val() == 'anyone' || newData.val() == 'registered' || newData.val() == 'verified')"
          },
          "minLevel": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
          },
          "maxLevel": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
          },
          "minPlayers": {
            ".validate": "newData.isNumber() && newData.val() >= 4 && newData.val() <= 100"
          },
          "maxPlayers": {
            ".validate": "newData.isNumber() && newData.val() >= 4 && newData.val() <= 100"
          }
        },
        "registeredPlayers": {
          "$playerId": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['id', 'name'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 50"
            }
          }
        }
      }
    },
    "community": {
      "messages": {
        ".read": true,
        "$messageId": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['name', 'text', 'timestamp'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 280"
          },
          "timestamp": {
            ".validate": "newData.isNumber()"
          },
          "reported": {
            ".validate": "newData.isBoolean()"
          },
          "reportCount": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          }
        }
      },
      "rateLimit": {
        "$ipHash": {
          ".read": false,
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['lastPost', 'count'])"
        }
      }
    },

    "deletionRequests": {
      "$uid": {
        ".read":  "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['uid', 'status', 'requestedAt', 'deadline'])",
        "uid":         { ".validate": "newData.isString() && newData.val() == $uid" },
        "status":      { ".validate": "newData.isString() && (newData.val() == 'pending' || newData.val() == 'processing' || newData.val() == 'completed')" },
        "reason":      { ".validate": "newData.isString() && newData.val().length <= 500" },
        "requestedAt": { ".validate": "newData.isString()" },
        "deadline":    { ".validate": "newData.isString()" }
      }
    },

    "rateLimits": {
      "$uid": {
        ".read":  "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "verifications": {
      ".indexOn": ["status", "organizerId", "submittedAt"],
      "$competitionId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['competitionId', 'status', 'organizerId'])",
        "competitionId": { ".validate": "newData.isString()" },
        "organizerId":   { ".validate": "newData.isString()" },
        "status": {
          ".validate": "newData.isString() && (newData.val() == 'pending' || newData.val() == 'submitted' || newData.val() == 'approved' || newData.val() == 'rejected')"
        },
        "paymentStatus": {
          ".validate": "newData.isString() && (newData.val() == 'awaiting_approval' || newData.val() == 'processing' || newData.val() == 'paid' || newData.val() == 'failed')"
        },
        "photos": {
          "$photoId": {
            ".validate": "newData.hasChildren(['url', 'uploadedAt'])"
          }
        },
        "playerConfirmations": {
          "$playerId": {
            ".validate": "newData.hasChildren(['agrees', 'confirmedAt'])"
          }
        },
        "organiserConfirmed": { ".validate": "newData.isBoolean()" },
        "prizePool":          { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "currency":           { ".validate": "newData.isString() && newData.val() == 'GBP'" }
      }
    },

    "admins": {
      ".read": "auth != null",
      ".write": false,
      "$uid": {
        ".validate": "newData.isBoolean()"
      }
    },

    "bug-reports": {
      ".read": true,
      ".write": true
    },

    ".read": false,
    ".write": false
  }
}
