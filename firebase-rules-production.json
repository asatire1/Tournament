{
  "rules": {
    "users": {
      ".read": true,
      ".indexOn": ["googleUid", "authUid", "email", "playtomicUsername"],
      "$userId": {
        ".write": "auth != null && auth.uid == $userId",
        ".validate": "newData.hasChildren(['name', 'type'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
        },
        "type": {
          ".validate": "newData.isString() && (newData.val() == 'guest' || newData.val() == 'registered')"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() == 'pending' || newData.val() == 'verified') && (newData.val() == 'pending' || (data.exists() && newData.val() == data.val()) || auth.token.admin == true || root.child('admins').child(auth.uid).val() == true)"
        },
        "isAdmin": {
          ".validate": "newData.isBoolean() && (newData.val() == false || auth.token.admin == true || root.child('admins').child(auth.uid).val() == true)"
        },
        "verifiedAt": {
          ".validate": "auth.token.admin == true || root.child('admins').child(auth.uid).val() == true"
        },
        "verifiedBy": {
          ".validate": "auth.token.admin == true || root.child('admins').child(auth.uid).val() == true"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "googleUid": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "authUid": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "authProvider": {
          ".validate": "newData.isString() && (newData.val() == 'google' || newData.val() == 'email' || newData.val() == 'anonymous')"
        },
        "playtomicUsername": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
        },
        "playtomicLevel": {
          ".validate": "(newData.isNumber() && newData.val() >= 0 && newData.val() <= 10) || newData.val() == null"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "isOrganizer": {
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isString()"
        },
        "updatedAt": {
          ".validate": "newData.isString()"
        },

        "notifications": {
          ".read":  "auth != null && auth.uid == $userId",
          ".write": "auth != null && auth.uid == $userId",
          "$notificationId": {
            ".validate": "newData.hasChildren(['type', 'title', 'body', 'read', 'createdAt'])",
            "type": {
              ".validate": "newData.isString() && (newData.val() == 'match_ready' || newData.val() == 'tournament_start' || newData.val() == 'result_posted' || newData.val() == 'tournament_complete' || newData.val() == 'registration_confirmed')"
            },
            "title":        { ".validate": "newData.isString() && newData.val().length <= 100" },
            "body":         { ".validate": "newData.isString() && newData.val().length <= 300" },
            "tournamentId": { ".validate": "newData.isString() || newData.val() == null" },
            "read":         { ".validate": "newData.isBoolean()" },
            "createdAt":    { ".validate": "newData.isString()" }
          }
        },

        "ratings": {
          ".read": true,
          ".write": "auth != null && auth.uid == $userId"
        }
      }
    },

    "userRatings": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || auth.token.admin == true)",
        "uid":          { ".validate": "newData.isString()" },
        "rating":       { ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 3000" },
        "confidence":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
        "gamesPlayed":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "lastPlayedAt": { ".validate": "newData.isString()" },
        "updatedAt":    { ".validate": "newData.isString()" },
        "history": {
          "$matchId": {
            ".validate": "newData.hasChildren(['before', 'after', 'delta', 'timestamp'])"
          }
        }
      }
    },

    "americano-tournaments": {
      ".read": true,
      ".indexOn": ["meta/organizerUid", "meta/updatedAt", "meta/createdAt"],
      "$tournamentId": {
        ".write": "auth != null && (!data.exists() || !data.child('meta/organizerUid').exists() || data.child('meta/organizerUid').val() == auth.uid || root.child('tournamentSecrets').child($tournamentId).child('claimant').val() == auth.uid)",
        ".validate": "$tournamentId.matches(/^[a-zA-Z0-9]{6,20}$/)",
        "scores": {
          "$matchId": {
            ".write": "auth != null",
            "team1": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
            },
            "team2": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
            }
          }
        },
        "meta": {
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          },
          "organiserKey": {
            ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 64"
          },
          "passcodeHash": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
          },
          "createdAt": {
            ".validate": "newData.isString()"
          },
          "updatedAt": {
            ".validate": "newData.isString()"
          },
          "organizerUid": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          }
        },
        "playerCount": {
          ".validate": "newData.isNumber() && newData.val() >= 4 && newData.val() <= 24"
        },
        "playerNames": {
          "$index": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
          }
        },
        "courtCount": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
        },
        "courtNames": {
          "$index": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
          }
        },
        "fixedPoints": {
          ".validate": "newData.isBoolean()"
        },
        "totalPoints": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
        }
      }
    },
    "mexicano-tournaments": {
      ".read": true,
      ".indexOn": ["meta/organizerUid", "meta/updatedAt", "meta/createdAt"],
      "$tournamentId": {
        ".write": "auth != null && (!data.exists() || !data.child('meta/organizerUid').exists() || data.child('meta/organizerUid').val() == auth.uid || root.child('tournamentSecrets').child($tournamentId).child('claimant').val() == auth.uid)",
        ".validate": "$tournamentId.matches(/^[a-zA-Z0-9]{6,20}$/)",
        "scores": {
          "$matchId": {
            ".write": "auth != null",
            "team1": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
            },
            "team2": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
            }
          }
        },
        "meta": {
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          },
          "organiserKey": {
            ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 64"
          },
          "passcodeHash": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
          },
          "organizerUid": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          }
        },
        "playerCount": {
          ".validate": "newData.isNumber() && newData.val() >= 4 && newData.val() <= 24"
        },
        "playerNames": {
          "$index": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
          }
        },
        "courtCount": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
        }
      }
    },
    "tournaments": {
      ".read": true,
      ".indexOn": ["meta/organizerUid", "meta/updatedAt", "meta/createdAt"],
      "$tournamentId": {
        ".write": "auth != null && (!data.exists() || !data.child('meta/organizerUid').exists() || data.child('meta/organizerUid').val() == auth.uid || root.child('tournamentSecrets').child($tournamentId).child('claimant').val() == auth.uid)",
        ".validate": "$tournamentId.matches(/^[a-zA-Z0-9]{6,20}$/)",
        "scores": {
          "$matchId": {
            ".write": "auth != null"
          }
        },
        "meta": {
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          }
        },
        "playerCount": {
          ".validate": "newData.isNumber() && newData.val() >= 4 && newData.val() <= 32"
        }
      }
    },
    "team-tournaments": {
      ".read": true,
      ".indexOn": ["meta/organizerUid", "meta/updatedAt", "meta/createdAt"],
      "$tournamentId": {
        ".write": "auth != null && (!data.exists() || !data.child('meta/organizerUid').exists() || data.child('meta/organizerUid').val() == auth.uid || root.child('tournamentSecrets').child($tournamentId).child('claimant').val() == auth.uid)",
        ".validate": "$tournamentId.matches(/^[a-zA-Z0-9]{6,20}$/)",
        "scores": {
          "$matchId": {
            ".write": "auth != null"
          }
        },
        "groupMatchScores": {
          ".write": "auth != null"
        },
        "knockoutScores": {
          ".write": "auth != null"
        },
        "knockoutTeams": {
          ".write": "auth != null && (!data.parent().child('meta').child('organizerUid').exists() || data.parent().child('meta').child('organizerUid').val() == auth.uid)"
        },
        "meta": {
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          }
        },
        "teamCount": {
          ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 36"
        }
      }
    },
    "mixicano-tournaments": {
      ".read": true,
      ".indexOn": ["meta/organizerUid", "meta/updatedAt", "meta/createdAt"],
      "$tournamentId": {
        ".write": "auth != null && (!data.exists() || !data.child('meta/organizerUid').exists() || data.child('meta/organizerUid').val() == auth.uid || root.child('tournamentSecrets').child($tournamentId).child('claimant').val() == auth.uid)",
        ".validate": "$tournamentId.matches(/^[a-zA-Z0-9]{6,20}$/)",
        "scores": {
          "$matchId": {
            ".write": "auth != null"
          }
        },
        "meta": {
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          },
          "organiserKey": {
            ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 64"
          },
          "passcodeHash": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
          },
          "organizerUid": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          }
        },
        "playerCount": {
          ".validate": "newData.isNumber() && newData.val() >= 4 && newData.val() <= 80"
        }
      }
    },
    "roundrobin-tournaments": {
      ".read": true,
      ".indexOn": ["meta/organizerUid", "meta/updatedAt", "meta/createdAt"],
      "$tournamentId": {
        ".write": "auth != null && (!data.exists() || !data.child('meta/organizerUid').exists() || data.child('meta/organizerUid').val() == auth.uid || root.child('tournamentSecrets').child($tournamentId).child('claimant').val() == auth.uid)",
        ".validate": "$tournamentId.matches(/^[a-zA-Z0-9]{6,20}$/)",
        "scores": {
          "$matchId": {
            ".write": "auth != null"
          }
        },
        "meta": {
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          },
          "organiserKey": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 64"
          },
          "organizerUid": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          }
        }
      }
    },
    "knockout-tournaments": {
      ".read": true,
      ".indexOn": ["meta/organizerUid", "meta/updatedAt", "meta/createdAt"],
      "$tournamentId": {
        ".write": "auth != null && (!data.exists() || !data.child('meta/organizerUid').exists() || data.child('meta/organizerUid').val() == auth.uid || root.child('tournamentSecrets').child($tournamentId).child('claimant').val() == auth.uid)",
        ".validate": "$tournamentId.matches(/^[a-zA-Z0-9]{6,20}$/)",
        "scores": {
          "$matchId": {
            ".write": "auth != null",
            "team1": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
            },
            "team2": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
            }
          }
        },
        "meta": {
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          },
          "organiserKey": {
            ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 64"
          },
          "passcodeHash": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
          },
          "createdAt":   { ".validate": "newData.isString()" },
          "updatedAt":   { ".validate": "newData.isString()" },
          "organizerUid":{ ".validate": "newData.isString() && newData.val().length <= 128" }
        }
      }
    },
    "swiss-tournaments": {
      ".read": true,
      ".indexOn": ["meta/organizerUid", "meta/updatedAt", "meta/createdAt"],
      "$tournamentId": {
        ".write": "auth != null && (!data.exists() || !data.child('meta/organizerUid').exists() || data.child('meta/organizerUid').val() == auth.uid || root.child('tournamentSecrets').child($tournamentId).child('claimant').val() == auth.uid)",
        ".validate": "$tournamentId.matches(/^[a-zA-Z0-9]{6,20}$/)",
        "scores": {
          "$matchId": {
            ".write": "auth != null"
          }
        },
        "meta": {
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          },
          "organiserKey": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 64"
          },
          "organizerUid": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          }
        }
      }
    },
    "team-leagues": {
      ".read": true,
      ".indexOn": ["meta/organizerUid", "meta/updatedAt", "meta/createdAt"],
      "$tournamentId": {
        ".write": "auth != null && (!data.exists() || !data.child('meta/organizerUid').exists() || data.child('meta/organizerUid').val() == auth.uid || root.child('tournamentSecrets').child($tournamentId).child('claimant').val() == auth.uid)",
        ".validate": "$tournamentId.matches(/^[a-zA-Z0-9]{6,20}$/)",
        "scores": {
          "$matchId": {
            ".write": "auth != null"
          }
        }
      }
    },
    "leagues": {
      ".read": true,
      ".indexOn": ["meta/organizerUid", "meta/updatedAt", "meta/createdAt"],
      "$leagueId": {
        ".write": "auth != null && (!data.exists() || !data.child('meta/organizerUid').exists() || data.child('meta/organizerUid').val() == auth.uid || root.child('tournamentSecrets').child($leagueId).child('claimant').val() == auth.uid)",
        ".validate": "$leagueId.matches(/^[a-zA-Z0-9]{6,20}$/)",
        "meta": {
          "organiserKey": { ".validate": false },
          "passcodeHash": { ".validate": false }
        }
      }
    },
    "fixed-tournaments": {
      ".read": true,
      ".indexOn": ["meta/organizerUid", "meta/updatedAt", "meta/createdAt"],
      "$tournamentId": {
        ".write": "auth != null && (!data.exists() || !data.child('meta/organizerUid').exists() || data.child('meta/organizerUid').val() == auth.uid || root.child('tournamentSecrets').child($tournamentId).child('claimant').val() == auth.uid)",
        ".validate": "$tournamentId.matches(/^[a-zA-Z0-9]{6,20}$/)",
        "scores": {
          "$matchId": {
            ".write": "auth != null"
          }
        }
      }
    },
    "competitions": {
      ".read": true,
      ".indexOn": ["meta/eventDate", "meta/status", "meta/format", "meta/organizerId", "meta/createdAt"],
      "$competitionId": {
        ".write": "auth != null && (!data.exists() || !data.child('meta/organizerId').exists() || data.child('meta/organizerId').val() == auth.uid)",
        "meta": {
          ".validate": "newData.hasChildren(['name', 'format', 'status'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          },
          "format": {
            ".validate": "newData.isString() && (newData.val() == 'americano' || newData.val() == 'mexicano' || newData.val() == 'mix' || newData.val() == 'team-league')"
          },
          "status": {
            ".validate": "newData.isString() && (newData.val() == 'draft' || newData.val() == 'registration' || newData.val() == 'active' || newData.val() == 'completed' || newData.val() == 'cancelled')"
          },
          "accessRestriction": {
            ".validate": "newData.isString() && (newData.val() == 'anyone' || newData.val() == 'registered' || newData.val() == 'verified')"
          },
          "minLevel": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
          },
          "maxLevel": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
          },
          "minPlayers": {
            ".validate": "newData.isNumber() && newData.val() >= 4 && newData.val() <= 100"
          },
          "maxPlayers": {
            ".validate": "newData.isNumber() && newData.val() >= 4 && newData.val() <= 100"
          }
        },
        "registeredPlayers": {
          "$playerId": {
            ".write": "auth != null && (auth.uid == $playerId || root.child('competitions').child($competitionId).child('meta').child('organizerId').val() == auth.uid || auth.token.admin == true || root.child('admins').child(auth.uid).val() == true)",
            ".validate": "newData.hasChildren(['id', 'name']) && newData.child('id').val() == $playerId",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 50"
            }
          }
        }
      }
    },
    "community": {
      "messages": {
        ".read": true,
        "$messageId": {
          ".write": "auth != null && (!data.exists() || auth.token.admin == true || root.child('admins').child(auth.uid).val() == true || (newData.exists() && newData.child('text').val() == data.child('text').val() && newData.child('name').val() == data.child('name').val() && newData.child('timestamp').val() == data.child('timestamp').val()))",
          ".validate": "newData.hasChildren(['name', 'text', 'timestamp'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 280"
          },
          "timestamp": {
            ".validate": "newData.isNumber()"
          },
          "reported": {
            ".validate": "newData.isBoolean()"
          },
          "reportCount": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          }
        }
      },
      "rateLimit": {
        "$ipHash": {
          ".read": false,
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['lastPost', 'count'])"
        }
      }
    },

    "deletionRequests": {
      "$uid": {
        ".read":  "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['uid', 'status', 'requestedAt', 'deadline'])",
        "uid":         { ".validate": "newData.isString() && newData.val() == $uid" },
        "status":      { ".validate": "newData.isString() && (newData.val() == 'pending' || newData.val() == 'processing' || newData.val() == 'completed')" },
        "reason":      { ".validate": "newData.isString() && newData.val().length <= 500" },
        "requestedAt": { ".validate": "newData.isString()" },
        "deadline":    { ".validate": "newData.isString()" }
      }
    },

    "rateLimits": {
      "$uid": {
        ".read":  "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "verifications": {
      ".indexOn": ["status", "organizerId", "submittedAt"],
      "$competitionId": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.admin == true || root.child('admins').child(auth.uid).val() == true || (!data.exists() && newData.child('organizerId').val() == auth.uid) || data.child('organizerId').val() == auth.uid)",
        ".validate": "newData.hasChildren(['competitionId', 'status', 'organizerId'])",
        "competitionId": { ".validate": "newData.isString()" },
        "organizerId":   { ".validate": "newData.isString() && (!data.exists() || newData.val() == data.val())" },
        "status": {
          ".validate": "newData.isString() && (((newData.val() == 'pending' || newData.val() == 'submitted') && newData.val() != data.val()) || newData.val() == data.val() || auth.token.admin == true || root.child('admins').child(auth.uid).val() == true)"
        },
        "paymentStatus": {
          ".validate": "newData.isString() && ((newData.val() == 'awaiting_approval' && newData.val() != data.val()) || newData.val() == data.val() || auth.token.admin == true || root.child('admins').child(auth.uid).val() == true)"
        },
        "photos": {
          "$photoId": {
            ".validate": "newData.hasChildren(['url', 'uploadedAt'])"
          }
        },
        "playerConfirmations": {
          "$playerId": {
            ".write": "auth != null && (auth.uid == $playerId || auth.token.admin == true || root.child('admins').child(auth.uid).val() == true || root.child('verifications').child($competitionId).child('organizerId').val() == auth.uid)",
            ".validate": "newData.hasChildren(['agrees', 'confirmedAt'])"
          }
        },
        "organiserConfirmed": { ".validate": "newData.isBoolean()" },
        "prizePool":          { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000 && (!data.exists() || newData.val() == data.val() || auth.token.admin == true || root.child('admins').child(auth.uid).val() == true)" },
        "currency":           { ".validate": "newData.isString() && newData.val() == 'GBP'" }
      }
    },

    "tournamentSecrets": {
      "$tid": {
        ".read": false,
        ".write": "auth != null && ((!data.exists() && root.child(newData.child('root').val()).child($tid).child('meta').child('organizerUid').val() == auth.uid) || (data.exists() && ((data.child('key').exists() && newData.child('proof').val() == data.child('key').val()) || (data.child('passcodeHash').exists() && newData.child('passcodeProof').val() == data.child('passcodeHash').val()))))",
        ".validate": "newData.hasChildren(['root', 'key', 'passcodeHash'])",
        "root":          { ".validate": "newData.isString() && newData.val().length <= 40 && (!data.exists() || newData.val() == data.val())" },
        "key":           { ".validate": "newData.isString() && newData.val().length >= 6 && newData.val().length <= 64 && (!data.exists() || newData.val() == data.val())" },
        "passcodeHash":  { ".validate": "newData.isString() && newData.val().length <= 128 && (!data.exists() || newData.val() == data.val())" },
        "proof":         { ".validate": "newData.isString() && newData.val().length <= 128" },
        "passcodeProof": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "claimant":      { ".validate": "newData.isString() && newData.val() == auth.uid" },
        "$other":        { ".validate": false }
      }
    },

    "admins": {
      ".write": false,
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.admin == true || root.child('admins').child(auth.uid).val() == true)",
        ".validate": "newData.isBoolean()"
      }
    },

    "bug-reports": {
      ".read": "auth != null && (auth.token.admin == true || root.child('admins').child(auth.uid).val() == true)",
      ".indexOn": ["createdAt", "status"],
      "$reportId": {
        ".write": "!data.exists() || auth.token.admin == true || (auth != null && root.child('admins').child(auth.uid).val() == true)",
        ".validate": "newData.hasChildren(['description', 'createdAt']) || !newData.exists()",
        "title":       { ".validate": "newData.val() == null || (newData.isString() && newData.val().length <= 200)" },
        "description": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 5000" },
        "priority":    { ".validate": "newData.isString() && newData.val().length <= 20" },
        "type":        { ".validate": "newData.isString() && (newData.val() == 'bug' || newData.val() == 'enhancement')" },
        "screenshot":  { ".validate": "newData.val() == null || (newData.isString() && newData.val().length <= 3000000)" },
        "pageUrl":     { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "userAgent":   { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "createdAt":   { ".validate": "newData.isString() && newData.val().length <= 40" },
        "status":      { ".validate": "newData.isString() && newData.val().length <= 20" },
        "resolvedAt":  { ".validate": "newData.val() == null || newData.isString()" },
        "$other":      { ".validate": false }
      }
    },

    ".read": false,
    ".write": false
  }
}
