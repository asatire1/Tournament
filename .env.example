# UberPadel Environment Variables
# Copy this file to .env and fill in your values.
# .env is git-ignored — NEVER commit it.
#
# Firebase client-side config (safe to expose; security is in Firebase Rules)
UBER_FIREBASE_API_KEY=your-api-key-here
UBER_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
UBER_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.europe-west1.firebasedatabase.app
UBER_FIREBASE_PROJECT_ID=your-project-id
UBER_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
UBER_FIREBASE_MESSAGING_SENDER_ID=000000000000
UBER_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxx
UBER_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry error tracking (optional — leave blank to disable)
UBER_SENTRY_DSN=
